// xxh64.nv — XXH64, in word algebra with no `Bytes` and no `Str`
// anywhere in the module.
//
// XXH64 IS NOT XXH32 AT DOUBLE THE WIDTH.  The differences are real
// and none of them is a width:
//
//   the stripe        THIRTY-TWO bytes, four lanes of eight.
//   the round         accumulate, rotate by 31, multiply — and then
//                     the MERGE applies the round a second time to
//                     each lane and multiplies by PRIME_1 before
//                     adding PRIME_4, which XXH32's merge does not do
//                     at all.
//   the tail          eight bytes at a time, then four, then one, each
//                     with its own constant.
//   the avalanche     shift 33, 29, 32 against XXH32's 15, 13, 16.
//   the primes        five different numbers.
//
// A port that widened XXH32 passes nothing, and so does a port that
// narrowed XXH64 into `xxh32`.
//
// WORDS ARE 64 BITS, WHICH IS THE WHOLE OF `Int`, so there is no mask
// step the way XXH32 needs one.  What there IS is wrapping: the
// algorithm is defined modulo 2^64 and `Int` traps on overflow
// (SPEC § 13.2), so every multiply and add is `std.int`'s wrapping
// form and every value this module answers is the reference
// algorithm's bit pattern reinterpreted as SIGNED.  Three of the five
// primes have their high bit set and are written as negative decimals
// for that reason.  `xxhbytes.text64` is how a caller prints one that
// matches `xxhsum`.
//
// THIS IS ONE OF THE TWO MODULES A DEVICE GETS — `start`, `feed_byte`
// and `finish` are a whole hash with no allocator behind them.

use std.bits
use std.int

// ── Sizes ────────────────────────────────────────────────────────────

// The stripe XXH64 consumes at a time: thirty-two bytes, four lanes of
// eight.
pub const XXH64_STRIPE_BYTES = 32

// The lanes: four.
pub const XXH64_LANES = 4

// The digest: eight bytes.
pub const XXH64_DIGEST_BYTES = 8

// ── The five primes ──────────────────────────────────────────────────
//
// Three of the five have their high bit set and `Int` is signed, so
// they cannot be written as hex literals.  The hexadecimal is beside
// each, because that is the form the reference implementation and
// every other port print.

// 0x9E3779B185EBCA87 — the round multiplier.
pub const XXH64_PRIME_1 = -7046029288634856825

// 0xC2B2AE3D27D4EB4F — the round's second multiplier.
pub const XXH64_PRIME_2 = -4417276706812531889

// 0x165667B19E3779F9 — the avalanche's first.
pub const XXH64_PRIME_3 = 1609587929392839161

// 0x85EBCA77C2B2AE63 — the merge's addend multiplier.
pub const XXH64_PRIME_4 = -8796714831421723037

// 0x27D4EB2F165667C5 — the tail's multiplier, and the seed offset the
// short-input path starts from.
pub const XXH64_PRIME_5 = 2870177450012600261

// ── The state ────────────────────────────────────────────────────────

// A running XXH64 between bytes.
//
// A `@value` struct of four accumulators, a four-word stripe buffer,
// a fill count, a length and a seed — eighty-eight bytes of the
// caller's own frame, and nothing on a heap.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.total(xxh64.start(0))}")            // 0
// ```
pub @value
struct Xxh64State
    // The four accumulators.
    v: [Int; 4]
    // Bytes seen but not yet folded into a lane, as four little-endian
    // 64-bit words: byte `j` is bits `8*(j mod 8)` of word `j / 8`.
    buf: [Int; 4]
    // Bytes of `buf` that hold input: 0 ..= 31.
    buffered: Int
    // Every byte fed so far.
    total: Int
    // The seed this state started from.
    seed: Int

// ── The arithmetic ───────────────────────────────────────────────────

// `x` rotated LEFT by `n` bits, over 64.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.rotl(1, 1)}")                       // 2
// ```
pub @tier(embedded)
fn rotl(x: Int, n: Int) -> Int []
    bits.rotate_left(x, n)

// One lane's round: `rotl(acc + input * PRIME_2, 31) * PRIME_1`.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.round(0, 0) == 0}")                 // true
// ```
pub @tier(embedded)
fn round(acc: Int, input: Int) -> Int []
    int.wrapping_mul(rotl(int.wrapping_add(acc, int.wrapping_mul(input, XXH64_PRIME_2)), 31), XXH64_PRIME_1)

// The merge step XXH32 has no counterpart for: `(h XOR round(0, lane))
// * PRIME_1 + PRIME_4`.
//
// Published separately because it is the difference between the two
// algorithms that a reader looking for one will not find in the round
// function — XXH64 applies the round a SECOND time, to the lane, on
// the way out.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.merge_lane(0, 0) == xxh64.XXH64_PRIME_4}")   // true
// ```
pub @tier(embedded)
fn merge_lane(h: Int, lane: Int) -> Int []
    int.wrapping_add(int.wrapping_mul(h ^ round(0, lane), XXH64_PRIME_1), XXH64_PRIME_4)

// The final mix: XOR-shift-multiply at 33, 29 and 32.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.avalanche(0)}")                     // 0
// ```
pub @tier(embedded)
fn avalanche(h: Int) -> Int []
    var x = h ^ (h >>> 33)
    x = int.wrapping_mul(x, XXH64_PRIME_2)
    x = x ^ (x >>> 29)
    x = int.wrapping_mul(x, XXH64_PRIME_3)
    x ^ (x >>> 32)

// ── Building and reading a state ─────────────────────────────────────

// A fresh state at this seed.
//
// The lanes start at `seed + PRIME_1 + PRIME_2`, `seed + PRIME_2`,
// `seed`, and `seed - PRIME_1`.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.seed(xxh64.start(7))}")             // 7
// ```
pub @tier(embedded)
fn start(seed: Int) -> Xxh64State []
    Xxh64State { v: [int.wrapping_add(int.wrapping_add(seed, XXH64_PRIME_1), XXH64_PRIME_2),
                     int.wrapping_add(seed, XXH64_PRIME_2),
                     seed,
                     int.wrapping_sub(seed, XXH64_PRIME_1)],
                 buf: [0, 0, 0, 0], buffered: 0, total: 0, seed: seed }

// Lane `i`, for `i` in 0 ..= 3.
pub @tier(embedded)
fn lane(st: Xxh64State, i: Int) -> Int []
    if i < 0 or i >= XXH64_LANES
        0
    else
        st.v[i]

// The same state with lane `i` set.
pub @tier(embedded)
fn with_lane(st: Xxh64State, i: Int, v: Int) -> Xxh64State []
    if i < 0 or i >= XXH64_LANES
        st
    else
        var r = st
        r.set_v(i, v)
        r

// Buffered byte `j`, for `j` in 0 ..= 31.
pub @tier(embedded)
fn buffer_byte(st: Xxh64State, j: Int) -> Int []
    if j < 0 or j >= XXH64_STRIPE_BYTES
        0
    else
        (st.buf[j / 8] >>> (8 * (j % 8))) & 0xFF

// Bytes of the stripe buffer that hold input: 0 ..= 31.
pub @tier(embedded)
fn buffered(st: Xxh64State) -> Int []
    st.buffered

// Every byte fed so far.
pub @tier(embedded)
fn total(st: Xxh64State) -> Int []
    st.total

// The seed this state started from.
pub @tier(embedded)
fn seed(st: Xxh64State) -> Int []
    st.seed

// ── The streaming hash, with no `Bytes` in it ────────────────────────

// One more byte of input.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.total(xxh64.feed_byte(xxh64.start(0), 0x61))}")   // 1
// ```
pub @tier(embedded)
fn feed_byte(st: Xxh64State, b: Int) -> Xxh64State []
    var r = st
    r.put(b)
    if r.buffered == XXH64_STRIPE_BYTES
        for i in 0..XXH64_LANES
            r.set_v(i, round(r.v[i], r.buf[i]))
        r.set_buffered(0)
    r

// The digest: the four lanes merged, the length mixed in, the tail
// consumed eight then four then one byte at a time, and the avalanche.
//
// A PURE READ — the state is unchanged, so a caller can report a
// running hash and keep feeding.  Below thirty-two bytes the merge is
// skipped and the hash starts from `seed + PRIME_5`.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.finish(xxh64.start(0)) != 0}")      // true
// ```
pub @tier(embedded)
fn finish(st: Xxh64State) -> Int []
    var h = 0
    if st.total >= XXH64_STRIPE_BYTES
        h = int.wrapping_add(int.wrapping_add(rotl(st.v[0], 1), rotl(st.v[1], 7)),
                             int.wrapping_add(rotl(st.v[2], 12), rotl(st.v[3], 18)))
        for i in 0..XXH64_LANES
            h = merge_lane(h, st.v[i])
    else
        h = int.wrapping_add(st.seed, XXH64_PRIME_5)
    h = int.wrapping_add(h, st.total)
    let words = st.buffered / 8
    for k in 0..words
        h = int.wrapping_add(int.wrapping_mul(rotl(h ^ round(0, st.buf[k]), 27), XXH64_PRIME_1), XXH64_PRIME_4)
    var pos = words * 8
    if st.buffered - pos >= 4
        let half = (st.buf[pos / 8] >>> (8 * (pos % 8))) & 0xFFFFFFFF
        h = int.wrapping_add(int.wrapping_mul(rotl(h ^ int.wrapping_mul(half, XXH64_PRIME_1), 23), XXH64_PRIME_2),
            XXH64_PRIME_3)
        pos = pos + 4
    for j in pos..st.buffered
        h = int.wrapping_mul(rotl(h ^ int.wrapping_mul(buffer_byte(st, j), XXH64_PRIME_5), 11), XXH64_PRIME_1)
    avalanche(h)

// ── Reading a digest out ─────────────────────────────────────────────

// Byte `i` of a finished digest, for `i` in 0 ..= 7, LITTLE-endian.
pub @tier(embedded)
fn byte_of(h: Int, i: Int) -> Int []
    if i < 0 or i >= XXH64_DIGEST_BYTES
        0
    else
        (h >>> (8 * i)) & 0xFF

// The low thirty-two bits of a 64-bit digest.
//
// THE CALL zstd-nv's FRAME TRAILER NEEDS.  A Zstandard frame's
// `Content_Checksum` is four bytes, not eight, and they are the low
// half of the XXH64 — so a reader comparing this package's answer
// against `zstd -l` has to truncate first, and this is where that is
// written down rather than rediscovered.
//
// ```novo
// use xxh64
//
// fn main() [io]
//     println("${xxh64.low32(0x1122334455667788)}")        // 1432778632
// ```
pub @tier(embedded)
fn low32(h: Int) -> Int []
    h & 0xFFFFFFFF

// The writers.  A `@value` struct is immutable outside a `var self`
// method, so every change to the state is one of these.
impl Xxh64State
    // Sets accumulator `i`.
    @tier(embedded)
    fn set_v(var self, i: Int, v: Int)
        self.v[i] = v

    // Sets how many bytes of the stripe buffer hold input.
    @tier(embedded)
    fn set_buffered(var self, n: Int)
        self.buffered = n

    // Appends one byte to the stripe buffer and counts it.
    @tier(embedded)
    fn put(var self, b: Int)
        let w = self.buffered / 8
        let sh = 8 * (self.buffered % 8)
        self.buf[w] = (self.buf[w] & ((0xFF << sh) ^ -1)) | ((b & 0xFF) << sh)
        self.buffered = self.buffered + 1
        self.total = self.total + 1
