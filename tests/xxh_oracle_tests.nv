@test
fn test_every_width_and_path_matches_the_reference() [io]
    let ls = lengths()
    let want = expected()
    for i in 0..ls.len()
        test.case("input of ${ls[i]} bytes")
        test.assert_eq_str(line(ls[i]), want[i])
