// xxh_oracle_tests.nv — every width and every length path of the
// package, against the reference library.
//
// The expected lines were produced by calling `libxxhash` 0.8.2 (the
// reference C implementation) on the same bytes: XXH32, XXH64, XXH3 at
// 64 bits unseeded, seeded and over a secret, and XXH3 at 128 bits
// unseeded, seeded and over a secret.  The lengths sit on both sides of
// every path boundary: 0, 1-3, 4-8, 9-16, 17-128, 129-240, and the long
// path with zero, one and several scrambled blocks.
//
// The input at length `n` is byte `i` = `(i*131 + (i/8)*17 + 7) mod 256`.
// The seed is `n*2654435761 + 12345` (XXH32 takes its low 32 bits) and
// the secret is `n mod 50` bytes into the 300 bytes of the same
// generator, `136 + n mod 100` bytes long.
//
// One line is: xxh32 xxh64 xxh3-64 xxh3-64-seeded xxh3-64-secret
// xxh3-128 xxh3-128-seeded xxh3-128-secret, in the text the reference
// tool prints, except the last field, which is the sixteen canonical
// bytes the `_into` form writes.

use std.test
use std.bytes
use xxhbytes

fn gen(n: Int) -> Bytes
    var b = bytes.zeros(n)
    for i in 0..n
        bytes.set_u8(b, i, (i * 131 + i / 8 * 17 + 7) & 255)
    b

fn secret_128_text(d: Bytes, k: Bytes) -> Str
    match xxhbytes.hash3_128_with_secret_into(d, k, bytes.zeros(16))
        Err(_)  => "refused"
        // The canonical bytes: the low half first, each half little-endian.
        Ok(out) => bytes.to_hex(out)

fn secret_64_text(d: Bytes, k: Bytes) -> Str
    match xxhbytes.hash3_64_with_secret(d, k)
        Err(_) => "refused"
        Ok(h)  => xxhbytes.text64(h)

fn line(n: Int) -> Str
    let d = gen(n)
    let s = n * 2654435761 + 12345
    let sec = gen(300)
    let k = bytes.slice(sec, n % 50, n % 50 + 136 + n % 100)
    let parts = [xxhbytes.text32(xxhbytes.hash32(d, s & 0xffffffff)),
                 xxhbytes.text64(xxhbytes.hash64(d, s)),
                 xxhbytes.text64(xxhbytes.hash3_64(d)),
                 xxhbytes.text64(xxhbytes.hash3_64_seeded(d, s)),
                 secret_64_text(d, k),
                 xxhbytes.text128(xxhbytes.hash3_128(d)),
                 xxhbytes.text128(xxhbytes.hash3_128_seeded(d, s)),
                 secret_128_text(d, k)]
    parts.join(" ")

fn lengths() -> [Int]
    [0,
        1,
        2,
        3,
        4,
        5,
        7,
        8,
        9,
        12,
        15,
        16,
        17,
        24,
        31,
        32,
        33,
        48,
        63,
        64,
        65,
        96,
        97,
        127,
        128,
        129,
        160,
        191,
        192,
        239,
        240,
        241,
        255,
        256,
        500,
        1023,
        1024,
        1025,
        1100,
        2047,
        2048,
        2049,
        4096,
        5000]

